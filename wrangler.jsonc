{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big12-board",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    // Pages fetched per cron run, by layer. The account is on Workers Paid (30 s CPU), so the
    // limit here is politeness, not CPU: at most 1 page per school site per run, interleaved
    // across schools. Every minute: 540 ESPN + 720 school pages per 3 hours.
    "ESPN_PER_RUN": "3",
    "SITE_PER_RUN": "4",
    // /probe captures raw responses into the probe table for building parser fixtures.
    // Turn off ("false") once the parsers are verified.
    "PROBE_ENABLED": "true"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "big12-board", "database_id": "552a886b-f91e-4015-bf64-c9cb50ac8de7" }
  ],
  "triggers": { "crons": ["* * * * *"] }

  // Optional secret, set with `wrangler secret put ADMIN_KEY`:
  //   ADMIN_KEY  enables POST /api/refresh (x-admin-key header) to run a batch on demand
}
